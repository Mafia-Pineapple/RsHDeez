<?xml version="1.0"?>
<sdf version="1.8">
  <model name="homebase">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>visual.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>collision.obj</uri>
          </mesh>
        </geometry>
      </collision>
      
	      <!-- Explicitly "cold" thermal definition -->
	 <!-- <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal">
	    <temperature>273.0</temperature>
	    <emissivity>0.0</emissivity>
      </plugin> -->
	</link>     
  </model>
</sdf>
