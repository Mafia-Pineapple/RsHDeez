<?xml version="1.0"?>
	<sdf version="1.8">
    <model name="boar">
      <static>false</static>
      <link name="body">
        <collision name="col">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry>
            <mesh>
              <uri>boar.obj</uri>
              <scale>0.5 0.5 0.5</scale>
            </mesh>
          </geometry>
          <temperature>311</temperature> <!-- ~38°C -->
        </visual>
      </link>
    </model>
  </sdf>