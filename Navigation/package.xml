<?xml version="1.0"?>
<package format="3">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>Quadcopter control library and node with Gazebo integration.</description>

  <maintainer email="Nicholas.b.sabatta@student.uts.edu.au">Nicholas Sabatta</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build & run dependencies -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Optional sim integration (keep as exec_dep so they aren't required to compile) -->
  <exec_depend>gazebo_ros</exec_depend>     <!-- Gazebo Classic -->
  <exec_depend>ros_gz</exec_depend>         <!-- Gazebo Sim (Ignition) bridge -->
  <exec_depend>ros_gz_sim</exec_depend>
<exec_depend>robot_state_publisher</exec_depend>
<exec_depend>joint_state_publisher</exec_depend>
<exec_depend>sjtu_drone_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
